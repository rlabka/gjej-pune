// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth Models (NextAuth + custom fields) ──────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String // bcrypt hash
  displayName   String?
  phone         String?
  companyName   String?
  role          String    @default("job-seeker") // "job-seeker" | "employer" | "admin"
  emailVerified DateTime?
  image         String?
  bio           String?
  location      String?
  website       String?
  experience    String    @default("[]") // JSON array [{role,company,period,description}]
  education     String    @default("[]") // JSON array [{degree,institution,period}]
  documents     String    @default("[]") // JSON array [{name,url,uploadedAt}]
  locale           String    @default("de") // user's preferred language: de, en, fr, it, sq
  isPremium        Boolean   @default(false)
  stripeCustomerId String?   @unique
  pushTokens       String    @default("[]") // JSON array of Expo push tokens
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  jobs          Job[]          @relation("UserJobs")
  jobSeekerAds  JobSeekerAd[] @relation("UserAds")
  favorites     Favorite[]
  settings      UserSettings?
  subscriptions Subscription[]
}

model UserSettings {
  id                  String  @id @default(cuid())
  userId              String  @unique
  emailNotifications  Boolean @default(true)
  interviewReminders  Boolean @default(true)
  newMessageAlerts    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Job Offer (Employer posts) ─────────────────────────────────

model Job {
  id            String   @id @default(cuid())
  userId        String
  category      String   // e.g. "Babysitter", "Cleaner"
  contactName   String
  contactSurname String
  contactPhone  String
  contactEmail  String?
  companyName   String?
  salary        Float?
  salaryType    String   @default("Hour") // "Hour" | "Month" | "Year" | "Provision"
  currency      String   @default("EUR")
  locationState String
  locationCity  String
  lat           Float?
  lng           Float?
  countryCode   String?
  when          String   @default("Negotiation") // "Urgent" | "Negotiation"
  description   String?
  status        String   @default("Active") // "Active" | "Paused" | "Closed"
  views         Int      @default(0)
  shares        Int      @default(0)
  images        JobImage[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation("UserJobs", fields: [userId], references: [id], onDelete: Cascade)
}

model JobImage {
  id        String   @id @default(cuid())
  jobId     String
  url       String   // file path or URL
  order     Int      @default(0)
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ─── Job Seeker Ad (Job Seeker posts a profile/ad) ──────────────

model JobSeekerAd {
  id            String   @id @default(cuid())
  userId        String
  category      String
  firstName     String
  surname       String
  phone         String
  email         String?
  age           Int?
  photoUrl      String?
  experience    String?  // e.g. "2 years", "5+ years"
  availability  String?  // "immediate" | "negotiable"
  livingPlace   String?
  lat           Float?
  lng           Float?
  countryCode   String?
  skills           String   @default("[]") // JSON array of skill strings
  spokenLanguages  String   @default("[]") // JSON array of language codes e.g. ["de","en","sq"]
  status           String   @default("Active") // "Active" | "Draft"
  views         Int      @default(0)
  shares        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation("UserAds", fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Messaging ──────────────────────────────────────────────────

model Conversation {
  id           String    @id @default(cuid())
  participant1 String
  participant2 String
  jobId        String?   // first job that triggered the chat
  jobTitle     String?   // first job title for display
  jobRefs      String    @default("[]") // JSON array [{jobId, jobTitle}]
  lastMessage  String?
  lastAt       DateTime  @default(now())
  createdAt    DateTime  @default(now())
  createdBy    String?   // user that initiated the chat; nullable for legacy rows

  messages Message[]

  @@unique([participant1, participant2])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  fileUrl        String?
  fileName       String?
  fileType       String?
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ─── Unique Views ────────────────────────────────────────────────
model UniqueView {
  id         String   @id @default(cuid())
  targetType String   // "job" | "ad"
  targetId   String
  viewerKey  String   // userId or IP hash for anonymous users
  createdAt  DateTime @default(now())

  @@unique([targetType, targetId, viewerKey])
}

// ─── CMS Site Content (Landing Page Overrides) ──────────────────
model SiteContent {
  id         String   @id @default(cuid())
  section    String   // e.g. "Hero", "FAQ", "Footer"
  fieldKey   String   // e.g. "title", "q1", "review1_text"
  locale     String   // "de" | "en" | "fr" | "it" | "sq"
  value      String   // text or image URL
  type       String   @default("text") // "text" | "image" | "richText"
  updatedAt  DateTime @updatedAt

  @@unique([section, fieldKey, locale])
}

// ─── Email Settings (SMTP Configuration) ────────────────────────
model EmailSettings {
  id          String  @id @default("default")
  smtpHost    String  @default("")
  smtpPort    Int     @default(587)
  smtpUser    String  @default("")
  smtpPass    String  @default("")
  fromName    String  @default("gjej-pune.com")
  fromEmail   String  @default("noreply@gjej-pune.com")
  encryption  String  @default("tls") // "tls" | "ssl" | "none"
  updatedAt   DateTime @updatedAt
}

// ─── Profile Views (who viewed my ad/job) ───────────────────────
model ProfileView {
  id         String   @id @default(cuid())
  viewerId   String   // who viewed
  viewedId   String   // owner of the job/ad
  targetType String   // "job" | "ad"
  targetId   String   // Job or Ad ID
  createdAt  DateTime @default(now())

  @@unique([viewerId, targetType, targetId])
}

// ─── Notifications ──────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String   // recipient
  type      String   // "profile_view" | "premium_activated" | "boost_active" | "new_message"
  title     String
  body      String
  read      Boolean  @default(false)
  meta      String   @default("{}") // JSON for links etc.
  createdAt DateTime @default(now())
}

// ─── Password Reset Tokens ──────────────────────────────────────
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

// ─── Subscriptions (Stripe) ─────────────────────────────────
model Subscription {
  id                    String    @id @default(cuid())
  userId                String
  stripeSubscriptionId  String    @unique
  stripePriceId         String
  status                String    // "active" | "canceled" | "past_due" | "trialing" | "incomplete"
  planDurationMonths    Int       // 1, 3, 6
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean   @default(false)
  canceledAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Plans (Admin-managed, Stripe-synced) ───────────────────────
model Plan {
  id              String   @id @default(cuid())
  label           String               // e.g. "Premium 1 Monat"
  role            String               // "job_seeker" | "employer"
  intervalType    String               // "day" | "week" | "month"
  intervalCount   Int                  // e.g. 1, 3, 6, 7, 14
  amountCents     Int                  // Current price in cents
  oldPriceCents   Int?                 // Strikethrough price (optional)
  currency        String   @default("eur")
  stripePriceId   String?              // Stripe Price ID
  stripeProductId String?              // Stripe Product ID
  isActive        Boolean  @default(true)
  isBestOffer     Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([role, isActive])
}

// ─── Job Categories (Admin-managed) ─────────────────────────────
model JobCategoryGroup {
  id     String @id @default(cuid())
  slug   String @unique
  icon   String // emoji
  labels Json   // { de: "...", en: "...", fr: "...", it: "...", sq: "..." }
  order  Int    @default(0)

  titles JobCategoryTitle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobCategoryTitle {
  id         String @id @default(cuid())
  categoryId String
  key        String @unique // the Albanian key stored in Job.category
  labels     Json   // { de: "...", en: "...", fr: "...", it: "...", sq: "..." }

  category JobCategoryGroup @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── SEO per Page ───────────────────────────────────────────────
model SeoPage {
  id          String  @id @default(cuid())
  pageKey     String  // e.g. "home", "jobs", "job-seekers", "about"
  locale      String  // "de" | "en" | "fr" | "it" | "sq"
  title       String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageKey, locale])
}

// ─── Favorites ───────────────────────────────────────────────────
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  targetType String   // "job" | "ad"
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
}

// ─── Ad Placements (Logo in Trust Section) ──────────────────
model AdPlacement {
  id                String    @id @default(cuid())
  companyName       String
  companyEmail      String
  companyWebsite    String?
  logoUrl           String?
  plan              String              // "3_months" | "6_months"
  durationMonths    Int                 // 3 or 6
  amountCents       Int                 // 18000 or 30000
  currency          String    @default("chf")
  status            String    @default("pending_payment")
                                        // "pending_payment" | "paid" | "active" | "rejected" | "expired"
  stripeSessionId   String?   @unique
  paidAt            DateTime?
  activatedAt       DateTime?
  expiresAt         DateTime?
  rejectedReason    String?
  userId            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([expiresAt])
}
