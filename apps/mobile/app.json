{
  "expo": {
    "name": "Gjej Pune",
    "slug": "gjp-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gjp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gjp.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "GJP needs access to your photos so you can upload a profile picture or attach images to messages.",
        "NSCameraUsageDescription": "GJP needs camera access so you can take a profile picture or attach photos to messages.",
        "NSDocumentsFolderUsageDescription": "GJP needs access to your documents so you can send files in chat conversations.",
        "LSApplicationQueriesSchemes": [
          "mailto",
          "tel",
          "sms"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.921043784034-24cuijgm7r0h1it42v3tb4rdt5kd0i24"
            ]
          }
        ]
      },
      "associatedDomains": []
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFCC00"
      },
      "package": "com.gjp.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.921043784034-24cuijgm7r0h1it42v3tb4rdt5kd0i24"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 360,
          "resizeMode": "contain",
          "backgroundColor": "#FFCC00"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#162C66",
          "defaultChannel": "messages"
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5c91da1-32bd-449f-9cfd-390db10bd66b"
      }
    },
    "owner": "rediiix"
  }
}
