# GJP Mobile — Environment Configuration
#
# Copy this file to `.env` and fill in values.
# All EXPO_PUBLIC_* vars are embedded at build time and available via
# process.env at runtime (see src/lib/config.ts).

# Backend API base URL.
# Local dev (iPhone via Expo Go on the same LAN):
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:4000
# Tunnel (ngrok / cloudflared):
#   EXPO_PUBLIC_API_URL=https://your-tunnel.ngrok-free.app
# Staging:
#   EXPO_PUBLIC_API_URL=https://staging.your-domain.com
EXPO_PUBLIC_API_URL=http://localhost:4000

# WebSocket (Socket.IO) URL — usually same host as API
EXPO_PUBLIC_WS_URL=http://localhost:4000
EXPO_PUBLIC_WS_PATH=/ws

# Default locale when device language is unsupported
EXPO_PUBLIC_DEFAULT_LOCALE=de
